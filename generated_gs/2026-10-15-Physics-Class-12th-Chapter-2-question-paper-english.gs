    }
    const item = form.addMultipleChoiceItem();
    const correctIndex = ["A", "B", "C", "D"].indexOf(ANSWER_KEY[index]);
    const choices = q.options.map((option, optionIndex) =>
      item.createChoice(option, optionIndex === correctIndex)
