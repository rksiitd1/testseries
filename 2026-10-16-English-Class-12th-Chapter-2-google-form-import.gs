function buildClass12Quiz() {
  const form = FormApp.openById(FORM_ID);
  form.setTitle('SHRI Classes | Class 12 English Test | 16 October 2026');
  form.setDescription('Class 12 English • Chapter 2: Bharat Is My Home\nTest date: 16 October 2026 • 100 MCQs • 120 minutes • 1 mark each\n\nChoose one answer for every question. Select your name first. Submit only once.');
  form.setIsQuiz(true);
  form.setConfirmationMessage('Your test has been submitted. Thank you.');
  form.getItems().forEach(item => {
    if (item.getTitle() === 'Untitled Question') form.deleteItem(item);
  });
  const nameItem = form.addListItem();
  nameItem.setTitle('Student name').setRequired(true).setChoices([
    'Anshu Kumari','Abhinandan Kumar','Binu Kumari','Kajal Kumari','Kartik Kumar','Kaushik Kumar','Khushboo Kumari','Komal Kumari','Krishna Kumar','Md. Ismail','Munni Kumari','Prince Kumar','Priyanka Kumari','Rupa Kumari','Sandhya Kumari','Sapna Kumari','Shubham Kumar','Srishti Kumari'
  ].map(name => nameItem.createChoice(name)));
  QUESTIONS.forEach((q, index) => {
    const item = form.addMultipleChoiceItem();
    item.setTitle(q.question);
    item.setRequired(true);
    item.setPoints(1);
    item.setChoices(q.options.map((option, optionIndex) => item.createChoice(option, 'ABCD'[optionIndex] === q.answer)));
  });
  Logger.log('Created ' + QUESTIONS.length + ' graded questions in ' + form.getEditUrl());
}

