function createShriClassesMathsClass10Form() {
  if (QUESTIONS.length !== 100) {
    throw new Error("Expected 100 questions, found " + QUESTIONS.length);
  }

  QUESTIONS.forEach((q, i) => {
    if (!q.question || !Array.isArray(q.options) || q.options.length !== 4) {
      throw new Error("Question " + (i + 1) + " must have text and exactly four options.");
    }
  });

  const form = FormApp.create(FORM_TITLE);
  form.setDescription(FORM_DESCRIPTION);
  form.setProgressBar(true);
  form.setShuffleQuestions(false);
  form.setConfirmationMessage("आपके उत्तर जमा हो गए हैं। SHRI CLASSES में भाग लेने के लिए धन्यवाद।");

  // Page 1: Student details
  form.addTextItem()
    .setTitle("Student Name")
    .setHelpText("अपना पूरा नाम लिखें।")
    .setRequired(true);

  const mobile = form.addTextItem()
    .setTitle("Mobile Number")
    .setHelpText("10 अंकों का भारतीय मोबाइल नंबर लिखें।")
    .setRequired(true);
  mobile.setValidation(
    FormApp.createTextValidation()
      .requireTextMatchesPattern("^[6-9][0-9]{9}$")
      .setHelpText("कृपया सही 10 अंकों का भारतीय मोबाइल नंबर लिखें।")
      .build()
  );

  const email = form.addTextItem()
    .setTitle("Email ID")
    .setHelpText("अपना ईमेल पता लिखें।")
    .setRequired(true);
  email.setValidation(
    FormApp.createTextValidation()
      .requireTextIsEmail()
      .setHelpText("कृपया सही ईमेल पता लिखें।")
      .build()
  );

  // Start the actual test on a separate page.
  form.addPageBreakItem()
    .setTitle("गणित परीक्षा | कक्षा 10वीं")
    .setHelpText("सम्पूर्ण पाठ्यक्रम | 100 वस्तुनिष्ठ प्रश्न");

  QUESTIONS.forEach((q, i) => {
    const number = i + 1;

    // Add a page break before questions 13, 25, 37, ... 97.
    // This gives 12 questions per page and 4 questions on the final page.
    if (number > 1 && (number - 1) % 12 === 0) {
      const start = number;
      const end = Math.min(number + 11, QUESTIONS.length);
      form.addPageBreakItem()
        .setTitle("प्रश्न " + start + "–" + end)
        .setHelpText("अपनी सुविधा के अनुसार प्रश्न छोड़ सकते हैं।");
    }

    const item = form.addMultipleChoiceItem();
    item.setTitle(number + ". " + q.question);
    item.setChoiceValues(q.options);
    item.setRequired(false);
  });

  Logger.log("FORM CREATED SUCCESSFULLY");
  Logger.log("Total questions: " + QUESTIONS.length);
  Logger.log("Student details: required");
  Logger.log("MCQs: optional");
  Logger.log("Edit URL: " + form.getEditUrl());
  Logger.log("Student URL: " + form.getPublishedUrl());
}
